#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$script_dir"

jar_path=""
for candidate in \
  "$repo_root/server/build/libs/server-all.jar" \
  "$repo_root/server/build/libs/mosa-server-all.jar"
do
  if [[ -f "$candidate" ]]; then
    jar_path="$candidate"
    break
  fi
done

if [[ -z "$jar_path" ]]; then
  mapfile -t shadow_candidates < <(ls -1 "$repo_root"/server/build/libs/*-all.jar 2>/dev/null || true)
  if [[ "${#shadow_candidates[@]}" -gt 0 ]]; then
    jar_path="${shadow_candidates[0]}"
  fi
fi

if [[ -z "$jar_path" ]]; then
  echo "Kein Shadow-Jar unter server/build/libs gefunden. Bitte zuerst mit ./gradlew :server:shadowJar bauen." >&2
  exit 1
fi

exec java -jar "$jar_path" "$@"
