#%RAML 1.0
title: Mosa Pod API
version: v1
baseUri: '{protocol}://{host}:{port}'
protocols: [ HTTP ]
mediaType: application/json

documentation:
  - title: Overview
    content: |
      The Mosa Pod provides a JSON HTTP API for publishing content, replying in threads,
      and performing semantic or thread-based queries. Authentication uses MIS-JWT bearer tokens
      except where explicitly noted. All versioned API routes live under the `/v1` prefix.

      Notes
      - Time fields use epoch seconds (integer) for `Instant` values.
      - Pagination for queries uses `queryOnId` returned by `/v1/query` and consumed by `/v1/queryon`.
      - Some endpoints are described but not yet implemented; they are clearly marked as UNIMPLEMENTED.
      - Request bodies are size-limited based on server configuration (`max-fetch-items` and optional `max-request-body-bytes`).

types:
  AuthenticationApprovalRequest:
    type: object
    properties:
      gid:
        type: string
        description: MIS GID of the client identity to approve
    example:
      gid: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'   

  PodCertificate:
    type: object
    properties:
      gid: string
      exp:
        type: integer
        format: int64
        description: Expiration time (epoch seconds)
      sig: string
      inf?: string
    example:
      gid: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'
      exp: 1700600000
      sig: 'MEUCIC1...'

  PodCertificateResponse:
    type: object
    properties:
      certificate: PodCertificate
      refreshRecommendedAt:
        type: integer
        format: int64
        description: Recommended refresh timestamp (epoch seconds)
    example:
      certificate:
        gid: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'
        exp: 1700600000
        sig: 'MEUCIC1...'
      refreshRecommendedAt: 1700300000

  PublishRequest:
    type: object
    properties:
      text:
        type: string
        maxLength: 1800
      signature:
        type: string
        description: Base64url-encoded Ed25519 signature over the canonical content payload
      signatureVersion:
        type: integer
        description: Version of the canonical content signature payload
    example:
      text: 'Hello Mosa! This is my first post.'
      signature: 'MEQCIAexampleSignature'
      signatureVersion: 1

  ReplyRequest:
    type: object
    properties:
      content: PublishRequest
      rootId: string
    example:
      content:
        text: 'I agree with your point.'
        signature: 'MEQCIAexampleSignature'
        signatureVersion: 1
      rootId: 'R0oTId42'

  QueryRequest:
    type: object
    properties:
      topic?:
        type: string
        description: Text describing the semantic topic to search for
      fromTime?:
        type: integer
        format: int64
        description: Only include results with storedAt >= this epoch second
      toTime?:
        type: integer
        format: int64
        description: Only include results with storedAt <= this epoch second
      threadRootId?:
        type: string
        description: Restrict results to a specific thread root
      scoreMustBeAbove?:
        type: number
        format: float
        description: Filter entries to those with similarity strictly above this value
      scoreMustBeBelow?:
        type: number
        format: float
        description: Filter entries to those with similarity strictly below this value
    example:
      topic: 'Functional programming for data processing'
      fromTime: 1700000000
      threadRootId: 'R0oTId42'
      scoreMustBeAbove: 0.85

  QueryOnRequest:
    type: object
    properties:
      queryOnId: string
    example:
      queryOnId: 'd4e7f6a0-9f9a-4f91-b3b0-9d3a2c2a6eab'

  QueryResultEntry:
    type: object
    properties:
      id: string
      content: string
      similarity: number
      authorGID: string
      storedAt:
        type: integer
        format: int64
      rootId?: string
      authorPublicKey: string
      authorSignature: string
      signatureVersion:
        type: integer
    example:
      id: 'AxY0b1p3...'
      content: 'A concise explanation of vector search.'
      similarity: 0.92
      authorGID: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'
      authorPublicKey: 'MCowBQYDK2VwAyEASamplePublicKey'
      authorSignature: 'MEQCIAexampleSignature'
      signatureVersion: 1
      storedAt: 1700000000
      rootId: 'R0oTId42'

  QueryResult:
    type: object
    properties:
      entries:
        type: QueryResultEntry[]
      queryOnId: string
    example:
      queryOnId: '6a7b5e3c-1234-5678-9abc-def012345678'
      entries:
        - id: 'AxY0b1p3...'
          content: 'A concise explanation of vector search.'
          similarity: 0.92
          authorGID: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'
          storedAt: 1700000000
          rootId: 'R0oTId42'

  SearchResultEntry:
    type: object
    properties:
      id: string
      similarity: number
    example:
      id: 'AxY0b1p3...'
      similarity: 0.92

  SearchResult:
    type: object
    properties:
      entries:
        type: SearchResultEntry[]
      queryOnId: string
    example:
      queryOnId: '6a7b5e3c-1234-5678-9abc-def012345678'
      entries:
        - id: 'AxY0b1p3...'
          similarity: 0.92

  FetchRequest:
    type: object
    properties:
      itemIds:
        type: string[]
        maxItems: 100
        description: Maximum number of items allowed per request (configurable on the server).
    example:
      itemIds:
        - 'AxY0b1p3...'
        - 'R0oTId42'

  FetchResultEntry:
    type: object
    properties:
      id: string
      content: string
      authorGID: string
      storedAt:
        type: integer
        format: int64
      rootId?: string
      authorPublicKey: string
      authorSignature: string
      signatureVersion:
        type: integer
    example:
      id: 'AxY0b1p3...'
      content: 'A concise explanation of vector search.'
      authorGID: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'
      authorPublicKey: 'MCowBQYDK2VwAyEASamplePublicKey'
      authorSignature: 'MEQCIAexampleSignature'
      signatureVersion: 1
      storedAt: 1700000000
      rootId: 'R0oTId42'

  FetchResult:
    type: object
    properties:
      entries:
        type: FetchResultEntry[]
    example:
      entries:
        - id: 'AxY0b1p3...'
          content: 'A concise explanation of vector search.'
          authorGID: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'
          storedAt: 1700000000
          rootId: 'R0oTId42'

  DeletePostsResult:
    type: object
    properties:
      ids:
        type: string[]
        description: IDs of deleted posts and replies
    example:
      ids:
        - 'AxY0b1p3...'
        - 'R0oTId42'

  DeleteIdentityResult:
    type: object
    properties:
      deletedPostIds:
        type: string[]
        description: IDs of deleted posts and replies owned by the authenticated identity
      deletedComplaintCount:
        type: integer
        description: Number of deleted complaint records linked to the authenticated identity
      deletedAdminMessageCount:
        type: integer
        description: Number of deleted admin message records linked to the authenticated identity
    example:
      deletedPostIds:
        - 'AxY0b1p3...'
        - 'R0oTId42'
      deletedComplaintCount: 2
      deletedAdminMessageCount: 1

  FreezeSnapshotRestoreResult:
    type: object
    properties:
      restoredIds:
        type: string[]
        description: IDs of restored content, complaint, and admin-message records
      restoredCount:
        type: integer
        description: Total number of restored records
    example:
      restoredIds:
        - 'AxY0b1p3...'
        - '6a7b5e3c-1234-5678-9abc-def012345678'
        - 'message-1'
      restoredCount: 3

  PostComplaintState:
    type: string
    enum: [ OPEN, CONFIRMED, REJECTED, DELETED ]

  PostComplaintAvailability:
    type: string
    enum: [ AVAILABLE, OPEN, BLOCKED ]

  CreatePostComplaintRequest:
    type: object
    properties:
      postId: string
      reason:
        type: string
        minLength: 1
        maxLength: 500
      signature:
        type: string
        description: Base64url-encoded Ed25519 signature over the canonical complaint payload
      signatureVersion:
        type: integer
        description: Version of the canonical complaint signature payload
    example:
      postId: 'AxY0b1p3...'
      reason: 'Spam'
      signature: 'MEQCIAcomplaintSignature'
      signatureVersion: 1

  DecidePostComplaintRequest:
    type: object
    properties:
      complaintId: string
      postId: string
      targetStatus: PostComplaintState
      feedback:
        type: string
        minLength: 1
        maxLength: 1000
      signature:
        type: string
        description: Base64url-encoded Ed25519 signature over the canonical complaint decision payload
      signatureVersion:
        type: integer
        description: Version of the canonical complaint decision signature payload
    example:
      complaintId: '6a7b5e3c-1234-5678-9abc-def012345678'
      postId: 'AxY0b1p3...'
      targetStatus: 'CONFIRMED'
      feedback: 'Checked'
      signature: 'MEQCIAdecisionSignature'
      signatureVersion: 1

  PostComplaintAvailabilityResult:
    type: object
    properties:
      postId: string
      availability: PostComplaintAvailability
    example:
      postId: 'AxY0b1p3...'
      availability: 'OPEN'

  OpenPostComplaint:
    type: object
    properties:
      complaintId: string
      postId: string
      postText: string
      postAuthorGid: string
      postCreatedAt:
        type: integer
        format: int64
      complainantGid: string
      reason: string
      createdAt:
        type: integer
        format: int64
    example:
      complaintId: '6a7b5e3c-1234-5678-9abc-def012345678'
      postId: 'AxY0b1p3...'
      postText: 'Foreign post'
      postAuthorGid: 'authorGid123'
      postCreatedAt: 1700000000
      complainantGid: 'complainantGid123'
      reason: 'Spam'
      createdAt: 1700000005

  OpenPostComplaintCountResult:
    type: object
    properties:
      count:
        type: integer
    example:
      count: 2

  OpenPostComplaintsResult:
    type: object
    properties:
      entries:
        type: OpenPostComplaint[]
      page:
        type: integer
      hasMore:
        type: boolean
    example:
      entries:
        - complaintId: '6a7b5e3c-1234-5678-9abc-def012345678'
          postId: 'AxY0b1p3...'
          postText: 'Foreign post'
          postAuthorGid: 'authorGid123'
          postCreatedAt: 1700000000
          complainantGid: 'complainantGid123'
          reason: 'Spam'
          createdAt: 1700000005
      page: 1
      hasMore: false

  CreateAdminMessageRequest:
    type: object
    properties:
      recipientGid:
        type: string
        description: MIS GID of the inbox recipient
      subject:
        type: string
        description: Short message subject
      body:
        type: string
        description: Message body text
    example:
      recipientGid: 'mZ0axz0t0z4IQsD4YBq1Hk3mQz0W9r1o'
      subject: 'Moderation Notice'
      body: 'Please review the latest community guidance.'

  AdminMessage:
    type: object
    properties:
      id: string
      senderGid: string
      createdAt:
        type: integer
        format: int64
      subject: string
      body: string
      remainingLifetimeDays:
        type: integer
        description: Remaining server-side lifetime in full or partial days, rounded up
    example:
      id: '6a7b5e3c-1234-5678-9abc-def012345678'
      senderGid: 'adminPodGid123'
      createdAt: 1700000000
      subject: 'Moderation Notice'
      body: 'Please review the latest community guidance.'
      remainingLifetimeDays: 28

  AdminMessageListResult:
    type: object
    properties:
      entries:
        type: AdminMessage[]
      page:
        type: integer
        description: Delivered 1-based page number
      hasMore:
        type: boolean
        description: Whether additional pages are available
    example:
      entries:
        - id: '6a7b5e3c-1234-5678-9abc-def012345678'
          senderGid: 'adminPodGid123'
          createdAt: 1700000000
          subject: 'Moderation Notice'
          body: 'Please review the latest community guidance.'
          remainingLifetimeDays: 28
      page: 1
      hasMore: false

  LegalDocumentChainResponse:
    type: object
    description: |
      Canonical legal document chain for one document kind.
      `baseline` contains the canonical baseline JSON object.
      `profiles` contains the canonical profile JSON objects in deterministic order
      from the first profile step up to the operator profile.
    properties:
      baseline:
        type: object
      profiles:
        type: object[]
    example:
      baseline:
        kind: baseline
        id: privacy-gdpr-baseline
        version: 1.0.0
      profiles:
        - kind: profile
          id: privacy-gdpr-default
          version: 1.0.0
        - kind: profile
          id: mosa-privacy-gdpr-service
          version: 1.0.0-draft2
        - kind: profile
          id: privacy-operator-service
          version: 1.0.0-draft2

  ImprintAddress:
    type: object
    properties:
      street?: string
      postalCode?: string
      city?: string
      region?: string
      country?: string
    example:
      street: "Musterstrasse 12"
      postalCode: "12345"
      city: "Berlin"
      region: "Berlin"
      country: "Deutschland"

  ImprintProviderBlock:
    type: object
    properties:
      name?: string
      legalForm?: string
      representative?: string
    example:
      name: "Beispielpod GmbH"
      legalForm: "GmbH"
      representative: "Mira Beispiel"

  ImprintContactBlock:
    type: object
    properties:
      email?: string
      phone?: string
      website?: string
    example:
      email: "kontakt@beispielpod.invalid"
      phone: "+49 30 1234567"
      website: "https://beispielpod.invalid"

  ImprintRegisterBlock:
    type: object
    properties:
      court?: string
      number?: string
      name?: string
    example:
      court: "Amtsgericht Berlin-Charlottenburg"
      number: "HRB 123456 B"
      name: "Handelsregister"

  ImprintTaxBlock:
    type: object
    properties:
      vatId?: string
      businessId?: string
      other?: string
    example:
      vatId: "DE123456789"
      businessId: "W-12345678"
      other: "Steuernummer 12/345/67890"

  ImprintSupervisionBlock:
    type: object
    properties:
      authority?: string
      address?: ImprintAddress
      website?: string
    example:
      authority: "Medienanstalt Berlin-Brandenburg"
      address:
        street: "Kleine Praesidentenstrasse 1"
        postalCode: "10178"
        city: "Berlin"
        region: "Berlin"
        country: "Deutschland"
      website: "https://www.mabb.de"

  ImprintEditorialBlock:
    type: object
    properties:
      responsiblePerson?: string
      address?: ImprintAddress
    example:
      responsiblePerson: "Mira Beispiel"
      address:
        street: "Musterstrasse 12"
        postalCode: "12345"
        city: "Berlin"
        region: "Berlin"
        country: "Deutschland"

  ImprintDocument:
    type: object
    properties:
      provider: ImprintProviderBlock
      address: ImprintAddress
      contact: ImprintContactBlock
      register?: ImprintRegisterBlock
      tax?: ImprintTaxBlock
      supervision?: ImprintSupervisionBlock
      editorial?: ImprintEditorialBlock
      additionalMarkdown?: string
    example:
      provider:
        name: "Beispielpod GmbH"
        legalForm: "GmbH"
        representative: "Mira Beispiel"
      address:
        street: "Musterstrasse 12"
        postalCode: "12345"
        city: "Berlin"
        region: "Berlin"
        country: "Deutschland"
      contact:
        email: "kontakt@beispielpod.invalid"
        phone: "+49 30 1234567"
        website: "https://beispielpod.invalid"
      register:
        court: "Amtsgericht Berlin-Charlottenburg"
        number: "HRB 123456 B"
        name: "Handelsregister"
      tax:
        vatId: "DE123456789"
        businessId: "W-12345678"
        other: "Steuernummer 12/345/67890"
      supervision:
        authority: "Medienanstalt Berlin-Brandenburg"
        address:
          street: "Kleine Praesidentenstrasse 1"
          postalCode: "10178"
          city: "Berlin"
          region: "Berlin"
          country: "Deutschland"
        website: "https://www.mabb.de"
      editorial:
        responsiblePerson: "Mira Beispiel"
        address:
          street: "Musterstrasse 12"
          postalCode: "12345"
          city: "Berlin"
          region: "Berlin"
          country: "Deutschland"
      additionalMarkdown: |
        ## Angaben gemaess § 5 DDG
        Dieses Beispiel dient nur als Vorlage.

traits:
  rateLimited:
    responses:
      429:
        description: Too Many Requests
        headers:
          Retry-After:
            type: integer
            description: Seconds to wait before retrying

securitySchemes:
  bearerAuth:
    type: Pass Through
    description: |
      MIS-JWT Bearer token in Authorization header (format: `Bearer <token>`).
      Token must include a `cert` claim with `gid` matching the approved identity.
    describedBy:
      headers:
        Authorization:
          type: string
          required: true
          description: 'Bearer <MIS-JWT>'

/:
  get:
    displayName: Get Client Index
    description: Serves the web client index page (HTML). Provided mainly for browser-based client usage.
    responses:
      200:
        body:
          text/html:
            example: |
              <!doctype html><html>...</html>
      404:
        description: Static client bundle not built or missing

/mosa-client.js:
  get:
    displayName: Get Client Script
    description: Serves the web client JavaScript bundle when available.
    responses:
      200:
        description: Returns the bundle when available, otherwise a fallback JS payload
        body:
          application/javascript:
            example: |
              console.log('Mosa client loaded');

/mosa-client.js.map:
  get:
    displayName: Get Client Source Map
    description: Serves the client source map when enabled on the server.
    responses:
      200:
        body:
          application/json:
            example: |
              { "version": 3, "sources": [] }
      404:
        description: Source map not available

/styles.css:
  get:
    displayName: Get Client Stylesheet
    description: Serves the client CSS bundle when available.
    responses:
      200:
        body:
          text/css:
            example: |
              body { font-family: sans-serif; }
      404:
        description: Stylesheet not available

/webfonts/{fontFile}:
  get:
    displayName: Get Font Asset
    description: Serves bundled webfont files.
    responses:
      200:
        body:
          font/woff2:
            example: |
              (binary)
      400:
        description: Invalid font filename
      404:
        description: Font not available

/{assetName}:
  get:
    displayName: Get Static Asset
    description: Serves a single static asset from the client bundle.
    responses:
      200:
        body:
          application/octet-stream:
            example: |
              (binary)
      400:
        description: Invalid asset name
      404:
        description: Asset not available

/v1:
  /approvegid:
    post:
      is: [ rateLimited ]
      displayName: Request Identity Approval
      description: |
        Approve a MIS `gid` to obtain a Pod certificate. This endpoint is unauthenticated.
        Requests are rate limited per IP. Limits are configured server-side and must be positive values.
      body:
        application/json:
          type: AuthenticationApprovalRequest
      responses:
        202:
          body:
            application/json:
              type: PodCertificateResponse
        400:
          description: Invalid request (e.g., malformed body)
        5xx:
          description: Server error

  /refreshgid:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Refresh Identity Approval
      description: |
        Refresh a Pod certificate using a valid MIS-JWT. Returns 202 with a new certificate when eligible.
      responses:
        202:
          body:
            application/json:
              type: PodCertificateResponse
        400:
          description: Certificate is too fresh to refresh
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /legal:
    /imprint:
      get:
        displayName: Get Imprint Document
        description: |
          Returns the pod operator's configured imprint document with fixed semantic blocks.
          This endpoint is unauthenticated.
        responses:
          200:
            body:
              application/json:
                type: ImprintDocument
          5xx:
            description: Server error

    /privacy:
      get:
        displayName: Get Privacy Document Chain
        description: |
          Returns the canonical privacy baseline and the complete ordered privacy profile chain.
          This endpoint is unauthenticated.
        responses:
          200:
            body:
              application/json:
                type: LegalDocumentChainResponse
          5xx:
            description: Server error

    /terms:
      get:
        displayName: Get Terms Document Chain
        description: |
          Returns the canonical terms baseline and the complete ordered terms profile chain.
          This endpoint is unauthenticated.
        responses:
          200:
            body:
              application/json:
                type: LegalDocumentChainResponse
          5xx:
            description: Server error

  /admin:
    /post-complaints:
      /count:
        get:
          is: [ rateLimited ]
          securedBy: [ bearerAuth ]
          displayName: Count Open Post Complaints
          description: |
            Return the number of complaints currently visible in the admin moderation queue.
            This includes open complaints and complaints that became unread again after a privacy-snapshot restore.
            The authenticated caller must be listed as an admin.
          responses:
            200:
              body:
                application/json:
                  type: OpenPostComplaintCountResult
            401:
              description: Missing or invalid bearer token
            403:
              description: Authenticated user is not allowed to access post complaints
            5xx:
              description: Server error
      get:
        is: [ rateLimited ]
        securedBy: [ bearerAuth ]
        displayName: List Open Post Complaints
        description: |
          Return a paged list of complaints currently visible in the admin moderation queue in ascending creation order.
          This includes open complaints and complaints that became unread again after a privacy-snapshot restore.
          The authenticated caller must be listed as an admin.
        queryParameters:
          page?:
            type: integer
            minimum: 1
            default: 1
            description: 1-based page number with a fixed server-side page size
        responses:
          200:
            body:
              application/json:
                type: OpenPostComplaintsResult
          400:
            description: Invalid request (e.g., page < 1 or non-integer page)
          401:
            description: Missing or invalid bearer token
          403:
            description: Authenticated user is not allowed to access post complaints
          5xx:
            description: Server error
      /decision:
        post:
          is: [ rateLimited ]
          securedBy: [ bearerAuth ]
          displayName: Decide Post Complaint
          description: |
            Close one open post complaint with an admin decision and send the admin feedback to the complainant inbox.
            The authenticated caller must be listed as an admin.
          body:
            application/json:
              type: DecidePostComplaintRequest
          responses:
            204:
              description: Complaint updated
            400:
              description: Invalid request (e.g., blank ids, blank feedback, OPEN targetStatus, or postId mismatch)
            401:
              description: Missing or invalid bearer token
            403:
              description: Authenticated user is not allowed to access post complaints
            404:
              description: Complaint or target post not found
            409:
              description: Complaint is already closed
            422:
              description: Unsupported signature version or signature verification failed
            5xx:
              description: Server error

    /messages:
      post:
        is: [ rateLimited ]
        securedBy: [ bearerAuth ]
        displayName: Send Admin Message
        description: |
          Send a private admin message to one recipient inbox.
          The authenticated sender must be listed as an admin.
        body:
          application/json:
            type: CreateAdminMessageRequest
        responses:
          204:
            description: Message accepted
          400:
            description: Invalid request (e.g., blank recipientGid, subject, or body)
          401:
            description: Missing or invalid bearer token
          403:
            description: Authenticated user is not allowed to send admin messages
          5xx:
            description: Server error
      get:
        is: [ rateLimited ]
        securedBy: [ bearerAuth ]
        displayName: Get Admin Message History
        description: |
          Return paged private admin messages that admins have sent to one recipient.
          The authenticated caller must be listed as an admin. Reading this history is read-only and does not shorten TTL.
        queryParameters:
          gid:
            type: string
            required: true
            description: MIS GID of the recipient whose admin-message history should be returned
          page?:
            type: integer
            minimum: 1
            default: 1
            description: 1-based page number with a fixed server-side page size of 10
        responses:
          200:
            body:
              application/json:
                type: AdminMessageListResult
          400:
            description: Invalid request (e.g., missing gid or page < 1)
          401:
            description: Missing or invalid bearer token
          403:
            description: Authenticated user is not allowed to read admin message history
          5xx:
            description: Server error

  /messages:
    get:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Get Admin Messages
      description: |
        Return paged private admin messages for the authenticated recipient inbox.
        Only messages for the caller's own identity are returned. Reading this inbox may shorten the remaining TTL
        for returned entries.
        The server returns only currently visible inbox messages with
        `createdAt >= fromTime`, sorted newest first. The time boundary is inclusive so the client can
        safely repeat the newest known timestamp and deduplicate by message id across refreshes.
        Older visible entries outside the requested window are not marked as retrieved by that refresh.
      queryParameters:
        page?:
          type: integer
          minimum: 1
          default: 1
          description: 1-based page number with a fixed server-side page size of 10
        fromTime?:
          type: integer
          format: int64
          minimum: 0
          default: 0
          description: |
            UTC epoch second for inbox filtering. Use `0` to request the full currently visible inbox.
            Pagination applies within the filtered result window.
      responses:
        200:
          body:
            application/json:
              type: AdminMessageListResult
        400:
          description: Invalid request (e.g., page < 1 or fromTime < 0)
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /privacy:
    /freeze:
      post:
        is: [ rateLimited ]
        securedBy: [ bearerAuth ]
        displayName: Freeze Privacy Snapshot
        description: |
          Freeze all pod-local data linked to the authenticated identity into an encrypted snapshot file.
          This includes owned content, complaints linked to the identity in both directions, and admin messages linked to the identity in both directions.
          After a successful freeze, the exported records are deleted from this pod.
        responses:
          200:
            body:
              application/octet-stream:
                example: |
                  (binary)
          401:
            description: Missing or invalid bearer token
          5xx:
            description: Server error

    /restore:
      post:
        is: [ rateLimited ]
        securedBy: [ bearerAuth ]
        displayName: Restore Privacy Snapshot
        description: |
          Restore a previously frozen snapshot for the authenticated identity on the same pod that created it.
          Restored admin messages become unread again in the recipient inbox.
          Restored complaints become unread again in the admin moderation queue.
        body:
          application/octet-stream:
            example: |
              (binary)
        responses:
          200:
            body:
              application/json:
                type: FreezeSnapshotRestoreResult
          401:
            description: Missing or invalid bearer token
          5xx:
            description: Server error

  /publish:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Publish Content
      description: |
        Publish a new root post. Returns 201 on success. Currently accepts any text; future moderation may reject off-topic content.
        UNIMPLEMENTED ASPECT: Off-topic rejection with 422 as described in README is not yet implemented.
      body:
        application/json:
          type: PublishRequest
      responses:
        201:
          description: Created
        400:
          description: Invalid request (e.g., malformed signature encoding or text exceeds 1800 characters)
        401:
          description: Missing or invalid bearer token
        422:
          description: Unsupported signature version or signature verification failed
        5xx:
          description: Server error

  /reply:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Reply To Content
      description: |
        Reply to an existing root post. The `rootId` must refer to an existing root post.
      body:
        application/json:
          type: ReplyRequest
      responses:
        201:
          description: Created
        400:
          description: Root not found, target is not a root post, malformed signature encoding, or text exceeds 1800 characters
        401:
          description: Missing or invalid bearer token
        422:
          description: Unsupported signature version or signature verification failed
        5xx:
          description: Server error

  /posts/{id}:
    /complaint-status:
      get:
        is: [ rateLimited ]
        securedBy: [ bearerAuth ]
        displayName: Get Post Complaint Availability
        description: |
          Return whether the authenticated user can currently create a new complaint for the addressed post.
        responses:
          200:
            body:
              application/json:
                type: PostComplaintAvailabilityResult
          400:
            description: Invalid or missing id
          401:
            description: Missing or invalid bearer token
          404:
            description: Post not found
          5xx:
            description: Server error
    delete:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Delete Content
      description: |
        Delete a post owned by the authenticated user. When deleting a root post, all replies to that post are deleted too.
      responses:
        200:
          description: Deleted
          body:
            application/json:
              type: DeletePostsResult
        400:
          description: Invalid or missing id
        401:
          description: Missing or invalid bearer token
        403:
          description: Not allowed to delete this post
        404:
          description: Post not found
        5xx:
          description: Server error

  /posts:
    delete:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Delete All Content
      description: |
        Delete all posts and replies owned by the authenticated user.
      responses:
        200:
          description: Deleted
          body:
            application/json:
              type: DeletePostsResult
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /identity:
    delete:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Delete Identity Data
      description: |
        Delete all pod-local data linked to the authenticated identity.
        This removes:
        - all posts and replies owned by the authenticated identity
        - all complaints created by the authenticated identity
        - all complaints about posts or replies owned by the authenticated identity
        - all admin messages linked to the authenticated identity
      responses:
        200:
          description: Deleted
          body:
            application/json:
              type: DeleteIdentityResult
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /post-complaints:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Create Post Complaint
      description: |
        Create a new complaint for one post.
        At most one open complaint can exist for a post at a time.
      body:
        application/json:
          type: CreatePostComplaintRequest
      responses:
        201:
          description: Created
        400:
          description: Invalid request (e.g., blank postId, blank reason, own post, malformed signature encoding, or reason exceeds 500 characters)
        401:
          description: Missing or invalid bearer token
        404:
          description: Post not found
        409:
          description: An open complaint already exists or new complaints are blocked for this post
        422:
          description: Unsupported signature version or signature verification failed
        5xx:
          description: Server error

  /query:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Query Content
      description: |
        Perform a semantic and/or thread/time constrained query. At least one of `topic`, `threadRootId`, `fromTime`, `toTime`, `scoreMustBeAbove`, `scoreMustBeBelow` must be provided.
      body:
        application/json:
          type: QueryRequest
      responses:
        200:
          body:
            application/json:
              type: QueryResult
        400:
          description: No search criteria provided
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /queryon:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Continue Query
      description: |
        Continue a previous query using the `queryOnId` returned by `/v1/query`.
        If `queryOnId` is empty or invalid, the server returns an empty page.
      body:
        application/json:
          type: QueryOnRequest
      responses:
        200:
          body:
            application/json:
              type: QueryResult
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /search:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Search Content
      description: |
        Perform a semantic and/or thread/time constrained query. Returns only ids with similarity scores.
        Same query rules as `/v1/query`.
      body:
        application/json:
          type: QueryRequest
      responses:
        200:
          body:
            application/json:
              type: SearchResult
        400:
          description: No search criteria provided
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /searchon:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Continue Search
      description: |
        Continue a previous search using the `queryOnId` returned by `/v1/search`.
        If `queryOnId` is empty or invalid, the server returns an empty page.
      body:
        application/json:
          type: QueryOnRequest
      responses:
        200:
          body:
            application/json:
              type: SearchResult
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error

  /fetch:
    post:
      is: [ rateLimited ]
      securedBy: [ bearerAuth ]
      displayName: Fetch Content
      description: |
        Fetch full content entries by id.
      body:
        application/json:
          type: FetchRequest
      responses:
        200:
          body:
            application/json:
              type: FetchResult
        400:
          description: Too many itemIds in request
        401:
          description: Missing or invalid bearer token
        5xx:
          description: Server error
